# Copy this file to `.env` and fill in your own values.
#
# All of this is optional. With no `.env` at all the app runs perfectly well:
# the Supabase client is simply null, and progress is kept in localStorage on
# the one browser. You lose sign-in and cross-device sync, nothing else.

# From your Supabase project: Settings -> API.
# The anon key is designed to be public and ships in the browser bundle. The
# database is protected by Row Level Security, not by keeping this secret.
VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# For whoever is building the site rather than learning from it. Signing in with
# a listed address unlocks every chapter without playing through the earlier
# ones, and adds a Reset progress control to the account menu.
#
# Vite inlines every VITE_ variable into the shipped JavaScript, so these
# addresses are readable by anyone who looks. That is fine because admin gates
# nothing but convenience. Do not grow it into something that guards real data;
# that belongs in an RLS policy.
VITE_ADMIN_EMAILS=you@example.com
