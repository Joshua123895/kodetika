# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local env files (keep Supabase keys out of git)
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# One-off dev scripts
# `scripts/*` rather than `scripts/`, because git cannot re-include a file whose
# parent directory is excluded — the negations below would be dead otherwise.
scripts/*
notes/

# ...except the ones the README tells contributors to run. The first two repair a
# failing test, so shipping the test without them would leave CI unfixable; the
# third is how backend levels get their expected output, and the house rule is
# that it is captured from a real run rather than typed.
!scripts/generate-bughunt.mjs
!scripts/star-budgets.mjs
!scripts/capture-backend.mjs

# CPython leaves these beside src/backend/miniweb.py whenever the test suite
# imports it from the repo rather than a temp dir.
__pycache__/
*.pyc

# Local Claude Code config, skills and worktrees
.claude/
